# Puerto del servidor
PORT=3000

# Secreto usado para firmar cookies de sesion. Cambialo en produccion.
SESSION_SECRET=change-me-in-production

# Ruta del archivo SQLite
DATABASE_FILE=./data/mm2trades.sqlite

# Poner en "true" solo detras de HTTPS
SECURE_COOKIES=false

# Crea un creador de demostracion al hacer seed (true/false)
SEED_DEMO=true
